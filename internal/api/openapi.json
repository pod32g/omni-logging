{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni-logging API",
    "version": "1.0.0",
    "description": "Ingest, search, aggregate, export, and live-tail logs. Ingest endpoints authenticate with an ingest API key (X-Api-Key or Bearer); query endpoints use the admin token (Bearer, ?token=, or the omnilog_token cookie). When no keys/token are configured, auth is disabled (dev mode)."
  },
  "servers": [
    {
      "url": "/",
      "description": "This server"
    }
  ],
  "tags": [
    {
      "name": "ingest"
    },
    {
      "name": "query"
    },
    {
      "name": "ops"
    },
    {
      "name": "alerts"
    },
    {
      "name": "pipelines"
    }
  ],
  "paths": {
    "/api/v1/ingest": {
      "post": {
        "tags": [
          "ingest"
        ],
        "summary": "Ingest structured events (JSON array or NDJSON)",
        "security": [
          {
            "ingestKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "application/x-ndjson": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "All accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "429": {
            "description": "Buffer full or admission control (rate limit / quota) rejected the request"
          }
        }
      }
    },
    "/api/v1/ingest/raw": {
      "post": {
        "tags": [
          "ingest"
        ],
        "summary": "Ingest raw text, one log line per line",
        "security": [
          {
            "ingestKey": []
          }
        ],
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rejected"
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": [
          "query"
        ],
        "summary": "Search events",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Query expression (filters, operators, free text). May also carry its own time range via last=/from=/to=, which takes precedence over the last/from/to parameters below. Use the attr. prefix to filter an attribute of that name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Absolute lower bound (RFC3339 or unix seconds). Ignored when q sets its own lower bound."
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Absolute upper bound (RFC3339 or unix seconds). Ignored when q sets to=."
          },
          {
            "name": "last",
            "in": "query",
            "description": "Relative window e.g. 15m, 1h, 7d. Ignored when the q expression sets its own lower bound.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "oldest"
              ]
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Keyset pagination cursor from a prior next_cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search/stats": {
      "get": {
        "tags": [
          "query"
        ],
        "summary": "Histogram + facets for a query",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "last",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Relative window e.g. 15m, 1h, 7d. Ignored when the q expression sets its own lower bound."
          },
          {
            "name": "interval",
            "in": "query",
            "description": "Histogram bucket width e.g. 1m",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stats",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/export": {
      "get": {
        "tags": [
          "query"
        ],
        "summary": "Stream all matching events (ignores the search limit)",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "last",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Relative window e.g. 15m, 1h, 7d. Ignored when the q expression sets its own lower bound."
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ndjson",
                "csv",
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Streamed export",
            "content": {
              "application/x-ndjson": {},
              "text/csv": {},
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/v1/tail": {
      "get": {
        "tags": [
          "query"
        ],
        "summary": "Live-tail matching events as Server-Sent Events",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "text/event-stream of LogEvent JSON",
            "content": {
              "text/event-stream": {}
            }
          }
        }
      }
    },
    "/api/v1/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness probe (always 200 if up)",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readiness probe (200 ready, 503 if store unreachable)",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Prometheus metrics",
        "responses": {
          "200": {
            "description": "Exposition",
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Operational snapshot (version, live-tail subscribers, ingest counters)",
        "description": "Admin-guarded on purpose: unlike the liveness probe, these counters describe traffic shape.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Read the runtime-mutable settings",
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Effective settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "503": {
            "description": "Settings management not enabled"
          }
        }
      },
      "put": {
        "tags": [
          "ops"
        ],
        "summary": "Update the runtime-mutable settings (validated, persisted, applied without a restart)",
        "description": "Fields omitted from the body keep their current value. Clearing one takes an explicit zero value, e.g. \"ingest_keys\": []. The admin token is not editable here.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Effective settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "400": {
            "description": "Invalid settings"
          },
          "503": {
            "description": "Settings management not enabled"
          }
        }
      }
    },
    "/api/v1/aggregate": {
      "get": {
        "tags": [
          "query"
        ],
        "summary": "Run a piped aggregation and return a table",
        "description": "The q parameter carries a filter followed by one pipeline stage, e.g. \"level=error | stats count by service\". Supported commands: stats, timechart (span=), top [N], rare [N]. Functions: count, sum, avg, min, max, dc.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Filter plus a pipeline stage",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Absolute lower bound (RFC3339 or unix seconds). Ignored when q sets its own lower bound."
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Absolute upper bound (RFC3339 or unix seconds). Ignored when q sets to=."
          },
          {
            "name": "last",
            "in": "query",
            "description": "Relative window e.g. 15m, 1h, 7d. Ignored when the q expression sets its own lower bound.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Aggregation table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AggResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query, or no aggregation stage present"
          }
        }
      }
    },
    "/api/v1/alerts": {
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "List alert rules",
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Rules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rules": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AlertRule"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "Create an alert rule",
        "security": [
          {
            "adminToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertRule"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertRule"
                }
              }
            }
          },
          "400": {
            "description": "Invalid rule or query"
          }
        }
      }
    },
    "/api/v1/alerts/{id}": {
      "put": {
        "tags": [
          "alerts"
        ],
        "summary": "Replace a rule's definition (firing state is preserved)",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertRule"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertRule"
                }
              }
            }
          },
          "400": {
            "description": "Invalid"
          },
          "404": {
            "description": "No such rule"
          }
        }
      },
      "delete": {
        "tags": [
          "alerts"
        ],
        "summary": "Delete a rule",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "No such rule"
          }
        }
      }
    },
    "/api/v1/alerts/{id}/test": {
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "Evaluate a rule now without changing its state or notifying",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertEvaluation"
                }
              }
            }
          },
          "404": {
            "description": "No such rule"
          }
        }
      }
    },
    "/api/v1/alerts/channels": {
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "List notification channels",
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Channels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "channels": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AlertChannel"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "Create a notification channel",
        "security": [
          {
            "adminToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertChannel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertChannel"
                }
              }
            }
          },
          "400": {
            "description": "Invalid channel"
          }
        }
      }
    },
    "/api/v1/alerts/channels/{id}": {
      "delete": {
        "tags": [
          "alerts"
        ],
        "summary": "Delete a channel",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "No such channel"
          }
        }
      }
    },
    "/api/v1/alerts/channels/{id}/test": {
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "Send a sample notification to verify a channel",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delivery outcome",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such channel"
          }
        }
      }
    },
    "/api/v1/pipelines": {
      "get": {
        "tags": [
          "pipelines"
        ],
        "summary": "List ingest pipelines and the built-in grok pattern names",
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Pipelines",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pipelines": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Pipeline"
                      }
                    },
                    "patterns": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "pipelines"
        ],
        "summary": "Create a pipeline",
        "security": [
          {
            "adminToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Pipeline"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pipeline"
                }
              }
            }
          },
          "400": {
            "description": "The pipeline does not compile"
          }
        }
      }
    },
    "/api/v1/pipelines/{id}": {
      "put": {
        "tags": [
          "pipelines"
        ],
        "summary": "Replace a pipeline",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Pipeline"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pipeline"
                }
              }
            }
          },
          "400": {
            "description": "Does not compile"
          },
          "404": {
            "description": "No such pipeline"
          }
        }
      },
      "delete": {
        "tags": [
          "pipelines"
        ],
        "summary": "Delete a pipeline",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "No such pipeline"
          }
        }
      }
    },
    "/api/v1/pipelines/test": {
      "post": {
        "tags": [
          "pipelines"
        ],
        "summary": "Run a sample line through pipelines without saving them",
        "description": "Omit 'pipelines' to test against the saved set. Grok is unforgiving enough that writing a pattern without testing it against a real line is guesswork.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "string"
                  },
                  "service": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "pipelines": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Pipeline"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "event": {
                      "$ref": "#/components/schemas/LogEvent"
                    },
                    "matched": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A pipeline does not compile"
          }
        }
      }
    },
    "/v1/logs": {
      "post": {
        "tags": [
          "ingest"
        ],
        "summary": "OTLP/HTTP logs receiver (protobuf and JSON, optionally gzipped)",
        "description": "The standard OTLP path, so OTEL_EXPORTER_OTLP_ENDPOINT pointing at this server works with no extra configuration. Both the protobuf and JSON encodings are accepted; an unrecognised Content-Type is treated as protobuf, which is what exporters default to. Resource attributes service.name and host.name become the event's service and source, the OTLP severity number becomes the level, and trace/span IDs become attributes.",
        "security": [
          {
            "ingestKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-protobuf": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted. A partialSuccess body reports how many records were refused.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "partialSuccess": {
                      "type": "object",
                      "properties": {
                        "rejectedLogRecords": {
                          "type": "integer"
                        },
                        "errorMessage": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The export could not be decoded"
          },
          "413": {
            "description": "Request body too large"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ingestKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LogEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          },
          "raw": {
            "type": "string"
          }
        }
      },
      "IngestResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer"
          },
          "rejected": {
            "type": "integer"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogEvent"
            }
          },
          "count": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "total_capped": {
            "type": "boolean",
            "description": "Counting stopped early; the real total exceeds total (render as \"total+\")"
          },
          "took_ms": {
            "type": "integer"
          },
          "next_cursor": {
            "type": "string"
          }
        }
      },
      "Settings": {
        "type": "object",
        "properties": {
          "retention_days": {
            "type": "integer",
            "description": "Delete events older than N days (0 = keep forever)"
          },
          "rate_limit_per_sec": {
            "type": "number",
            "description": "Per-key ingest REQUEST token refill per second (0 = off). Counts requests, not events."
          },
          "rate_burst": {
            "type": "integer",
            "description": "Token-bucket capacity"
          },
          "daily_quota_events": {
            "type": "integer",
            "description": "Max accepted events per key per UTC day (0 = unlimited)"
          },
          "daily_quota_bytes": {
            "type": "integer",
            "description": "Max ingested bytes per key per UTC day (0 = unlimited)"
          },
          "log_level": {
            "type": "string",
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ]
          },
          "ingest_keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Empty means ingestion is unauthenticated (dev mode)"
          }
        }
      },
      "Status": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "subscribers": {
            "type": "integer",
            "description": "Active live-tail subscribers"
          },
          "ingest": {
            "type": "object",
            "properties": {
              "received": {
                "type": "integer"
              },
              "written": {
                "type": "integer"
              },
              "dropped": {
                "type": "integer"
              },
              "rejected": {
                "type": "integer"
              },
              "queued": {
                "type": "integer"
              }
            }
          }
        }
      },
      "StatsResult": {
        "type": "object",
        "properties": {
          "histogram": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "count": {
                  "type": "integer"
                }
              }
            }
          },
          "facets": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "total": {
            "type": "integer"
          },
          "took_ms": {
            "type": "integer"
          }
        }
      },
      "AggResult": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group labels first, then one per measure"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {}
            },
            "description": "Row values, aligned to columns"
          },
          "group_columns": {
            "type": "integer",
            "description": "How many leading columns are group labels; the rest are measures"
          },
          "truncated": {
            "type": "boolean",
            "description": "More groups matched than were returned"
          },
          "took_ms": {
            "type": "integer"
          }
        }
      },
      "AlertRule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "query": {
            "type": "string",
            "description": "Any search expression, optionally with an aggregation stage"
          },
          "window_seconds": {
            "type": "integer",
            "description": "How far back each evaluation looks; must be >= interval_seconds"
          },
          "interval_seconds": {
            "type": "integer",
            "description": "How often to evaluate (minimum 10)"
          },
          "condition": {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "eq",
                  "ne"
                ]
              },
              "value": {
                "type": "number"
              }
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "error",
              "warning",
              "info",
              "debug"
            ],
            "default": "warning",
            "description": "How bad the rule is when firing, independent of its state. Forwarded to omni-notify channels, where routes match on it."
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Channel IDs notified on state transitions"
          },
          "enabled": {
            "type": "boolean"
          },
          "state": {
            "type": "string",
            "enum": [
              "ok",
              "firing",
              "unknown"
            ],
            "readOnly": true
          },
          "state_since": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "last_eval": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "last_value": {
            "type": "number",
            "readOnly": true
          },
          "last_error": {
            "type": "string",
            "readOnly": true
          }
        }
      },
      "AlertChannel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "webhook",
              "slack",
              "omni-notify"
            ]
          },
          "url": {
            "type": "string",
            "description": "Destination. webhook receives the full JSON payload; slack receives {text}; omni-notify receives an event POSTed to <url>/api/v1/events (the path is appended if absent)."
          },
          "token": {
            "type": "string",
            "description": "Bearer credential sent as Authorization: Bearer. Required for omni-notify. Write-only: reads back masked, and posting the mask back is rejected."
          }
        }
      },
      "AlertEvaluation": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "type": "number",
            "description": "The value compared against the threshold"
          },
          "firing": {
            "type": "boolean"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "value": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "PipelineStage": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "grok",
              "regex",
              "timestamp",
              "level",
              "service",
              "rename",
              "remove",
              "set"
            ]
          },
          "field": {
            "type": "string",
            "description": "Input field; a first-class field or attr.name. Defaults to message"
          },
          "pattern": {
            "type": "string",
            "description": "grok expression or RE2 pattern"
          },
          "to": {
            "type": "string",
            "description": "Target for rename/set"
          },
          "value": {
            "type": "string",
            "description": "Literal for set"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Targets for remove"
          },
          "layouts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Go time layouts for timestamp"
          },
          "fail_pipeline": {
            "type": "boolean",
            "description": "Abort the pipeline if this stage fails (default: skip it)"
          }
        }
      },
      "Pipeline": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "match": {
            "type": "string",
            "description": "Search expression selecting which events this applies to; empty means all"
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PipelineStage"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "order": {
            "type": "integer",
            "description": "Lower runs first"
          }
        }
      }
    }
  }
}
